<Window x:Class="IxtlanCalendar.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:IxtlanCalendar"
        xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
        mc:Ignorable="d"
        Title="Ixtlan Calendar" Height="450" Width="800"
        Background="#F6F6F6"
        Icon="/calendar.ico"
        >
    <Grid Margin="10">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Commands -->
                <RowDefinition Height="Auto" /> <!-- Week days -->
                <RowDefinition Height="*"/>  <!-- Dates -->
            </Grid.RowDefinitions>
            
            
            
            <!-- COMMANDS PANEL  -->
            <Grid Grid.Row="0" 
                  Margin="0,0,0,10"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Center"
                  
                  >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                
                <ComboBox Grid.Row="0" Grid.Column="0" x:Name="MonthComboBox"
                             IsEditable="True"
                             IsReadOnly="True"
                             VerticalContentAlignment="Center"
                             HorizontalContentAlignment="Center"
                             Width="200"
                             SelectionChanged="MonthComboBox_OnSelectionChanged"
                             Margin="0,0,10,0"
                             mah:TextBoxHelper.Watermark="-- Select Month --" 
                >
                    <ComboBoxItem Content="January" />
                    <ComboBoxItem Content="February" />
                    <ComboBoxItem Content="March" />
                    <ComboBoxItem Content="April" />
                    <ComboBoxItem Content="May" />
                    <ComboBoxItem Content="June" />
                    <ComboBoxItem Content="July" />
                    <ComboBoxItem Content="August" />
                    <ComboBoxItem Content="September" />
                    <ComboBoxItem Content="October" />
                    <ComboBoxItem Content="November" />
                    <ComboBoxItem Content="December" />
                </ComboBox>
                
                <TextBox Grid.Row="0" Grid.Column="1"
                         Width="100"
                         mah:TextBoxHelper.Watermark="-- Enter Year --" 
                         x:Name="YearTextBox"
                         TextAlignment="Center"
                         VerticalContentAlignment="Center"
                         TextChanged="YearTextBox_OnTextChanged"
                         PreviewTextInput="YearTextBox_PreviewTextInput" />
                
                <Label Grid.Column="3"
                       x:Name="MonthYearLabel"
                       FontWeight="Bold"
                       FontSize="14"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       />
                
                <!-- New small grid for date input and custom tooltip -->
                <Grid Grid.Column="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                             x:Name="FullDateTextBox"
                             Width="150"
                             mah:TextBoxHelper.Watermark="-- Enter Custom Date --"
                             TextAlignment="Center"
                             VerticalContentAlignment="Center"
                             HorizontalContentAlignment="Center"
                             TextChanged="FullDateTextBox_OnTextChanged" />
                    
                    <TextBlock Grid.Column="1"
                               Text="ℹ"
                               
                               Foreground="DodgerBlue"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"

                               Margin="6,0,0,0"
                               ToolTip="Enter Custom Date &#x0a;Format: DD.MM.YYYY"
                               Cursor="Help" />
                </Grid>
            </Grid>
            
            
            <!-- Week days -->
            <Border Grid.Row="1"
                Background="#4ECDC4"
                BorderThickness="0, 1, 0, 1"
                BorderBrush="Black" 
                >
                <!-- <UniformGrid Columns="7" Rows="1" x:Name="WeekDaysGrid" /> -->
                <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                            
                    
            <Label
                Grid.Row="0" Grid.Column="0"
                Content="Mon"
                HorizontalContentAlignment="Center"
                HorizontalAlignment="Center"
                VerticalContentAlignment="Center"
                FontWeight="Bold"  />
            <Label
                Grid.Row="0" Grid.Column="1"
                Content="Tue"
                HorizontalContentAlignment="Center"
                HorizontalAlignment="Center"
                VerticalContentAlignment="Center"
                FontWeight="Bold"  />
            <Label
                Grid.Row="0" Grid.Column="2"
                Content="Wed"
                HorizontalContentAlignment="Center"
                HorizontalAlignment="Center"
                VerticalContentAlignment="Center"
                FontWeight="Bold"  />
            <Label
                Grid.Row="0" Grid.Column="3"
                Content="Thu"
                HorizontalContentAlignment="Center"
                HorizontalAlignment="Center"
                VerticalContentAlignment="Center"
                FontWeight="Bold"  />
            <Label
                Grid.Row="0" Grid.Column="4"
                Content="Fri"
                HorizontalContentAlignment="Center"
                HorizontalAlignment="Center"
                VerticalContentAlignment="Center"
                FontWeight="Bold"  />
            <Label
                Grid.Row="0" Grid.Column="5"
                Content="Sat"
                HorizontalContentAlignment="Center"
                HorizontalAlignment="Center"
                VerticalContentAlignment="Center"
                FontWeight="Bold"  />
            <Label
                Grid.Row="0" Grid.Column="6"
                Content="Sun"
                HorizontalContentAlignment="Center"
                HorizontalAlignment="Center"
                VerticalContentAlignment="Center"
                FontWeight="Bold"  />
            </Grid>
            </Border>
            
            <!-- Dates -->
            <UniformGrid Grid.Row="2" Columns="7" Rows="6" x:Name="DatesGrid" />
            
            
            
            
            
        </Grid>
        
        
        
    </Grid>
</Window>
